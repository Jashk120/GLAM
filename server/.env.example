OPENROUTER_API_KEY=sk-or-your-key-here
# Choose openrouter (default) or ollama. Ollama needs no API key.
# LLM_PROVIDER=ollama
# OLLAMA_MODEL=qwen2.5-coder:14b
# OLLAMA_ENDPOINT=http://127.0.0.1:11434/api/chat
# OLLAMA_TIMEOUT=180s
# Optional overrides
# OPENROUTER_ENDPOINT=https://openrouter.ai/api/v1/chat/completions
# OPENROUTER_MODEL=google/gemma-4-31b-it:free
# OPENROUTER_TIMEOUT=60s
# OPENROUTER_MAX_TOKENS=6000
# OPENROUTER_ERROR_PREVIEW_LIMIT=2000
# OPENROUTER_REFERER=https://your-site.com
# OPENROUTER_TITLE=GLAM
# --- Backward compat (deprecated, use OPENROUTER_* above) ---
# OPENCODE_API_KEY=sk-your-key-here
# OPENCODE_ENDPOINT=https://opencode.ai/zen/go/v1/responses
# OPENCODE_MODEL=muse-spark-1.2-contributor
# PORT=8080
# GLAM_ROOT=/path/to/GLAM
# OPENROUTER_AGENT_MODEL=google/gemma-4-31b-it:free
# PIPELINE_MAX_STAGE_RETRIES=2
# AGENT_MAX_TOOL_ITERATIONS=4
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
