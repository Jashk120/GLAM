      "interaction": {
        "type": "math",
        "question": "Ranger counted 8 trees around clearing_1 and 6 around clearing_2. How many total?",
        "answer": 14,
        "hint": "8+6",
        "onCorrect": { "toast": "✅ 14 trees!" }
      }
