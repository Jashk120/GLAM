{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glam.example.com/schemas/scenario.schema.json",
  "title": "GLAM Scenario",
  "description": "Strict contract between LLM generator, Go validator, and Phaser runtime. LLM must only reference registry IDs — no executable code fields.",
  "type": "object",
  "additionalProperties": false,
  "propertyNames": {
    "not": {
      "enum": ["code", "script", "component", "bundle"]
    }
  },
  "required": ["id", "title", "world", "characters", "buildings", "objects", "missions"],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9_-]*$",
      "description": "Scenario identifier — kebab-case or snake_case, no spaces."
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20,
      "default": "1.0",
      "pattern": "^[0-9]+\\.[0-9]+(\\.[0-9]+)?(-[a-z0-9]+)?$",
      "description": "Semantic version, defaults to 1.0 when omitted."
    },
    "world": { "$ref": "#/$defs/world" },
    "initialStats": { "$ref": "#/$defs/initialStats" },
    "characters": {
      "type": "array",
      "minItems": 0,
      "maxItems": 20,
      "items": { "$ref": "#/$defs/character" }
    },
    "buildings": {
      "type": "array",
      "minItems": 0,
      "maxItems": 30,
      "items": { "$ref": "#/$defs/building" }
    },
    "objects": {
      "type": "array",
      "minItems": 0,
      "maxItems": 30,
      "items": { "$ref": "#/$defs/scenarioObject" }
    },
    "missions": {
      "type": "array",
      "minItems": 0,
      "maxItems": 20,
      "items": { "$ref": "#/$defs/mission" }
    }
  },
  "$defs": {
    "position": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": {
        "not": { "enum": ["code", "script", "component", "bundle"] }
      },
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "integer", "minimum": 0, "maximum": 30 },
        "y": { "type": "integer", "minimum": 0, "maximum": 30 }
      }
    },
    "size": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": {
        "not": { "enum": ["code", "script", "component", "bundle"] }
      },
      "required": ["cols", "rows"],
      "properties": {
        "cols": { "type": "integer", "minimum": 8, "maximum": 30 },
        "rows": { "type": "integer", "minimum": 8, "maximum": 20 }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": {
        "not": { "enum": ["code", "script", "component", "bundle"] }
      },
      "properties": {
        "stat": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[a-z0-9_]+$",
          "description": "Stat key to modify (e.g. coins, lives, score)."
        },
        "delta": {
          "type": "integer",
          "description": "Amount to add to stat (negative allowed)."
        },
        "toast": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "Short feedback message shown to player."
        }
      }
    },
    "world": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": {
        "not": { "enum": ["code", "script", "component", "bundle"] }
      },
      "required": ["template", "spawn", "size"],
      "properties": {
        "template": {
          "type": "string",
          "enum": ["town", "forest", "desert", "school"]
        },
        "regions": {
          "type": "array",
          "maxItems": 20,
          "items": { "$ref": "#/$defs/region" }
        },
        "spawn": { "$ref": "#/$defs/position" },
        "size": { "$ref": "#/$defs/size" },
        "theme": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "description": "Visual theme override; free-form but typically matches template."
        }
      }
    },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": {
        "not": { "enum": ["code", "script", "component", "bundle"] }
      },
      "required": ["id"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "maxLength": 64
        },
        "name": { "type": "string", "minLength": 1, "maxLength": 64 },
        "x": { "type": "integer", "minimum": 0, "maximum": 30 },
        "y": { "type": "integer", "minimum": 0, "maximum": 30 },
        "width": { "type": "integer", "minimum": 1, "maximum": 30 },
        "height": { "type": "integer", "minimum": 1, "maximum": 20 },
        "type": { "type": "string", "minLength": 1, "maxLength": 32 }
      }
    },
    "character": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": {
        "not": { "enum": ["code", "script", "component", "bundle"] }
      },
      "required": ["id", "name", "position"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "maxLength": 64
        },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "profession": { "type": "string", "minLength": 1, "maxLength": 64 },
        "appearance": { "$ref": "#/$defs/appearance" },
        "position": { "$ref": "#/$defs/position" },
        "plot": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "maxLength": 64,
          "description": "Optional plot/clearing id hint — must match a world layout plot (e.g. plot_1, clearing_2). Validator ensures position lies inside it."
        },
        "interaction": { "$ref": "#/$defs/interaction" }
      }
    },
    "appearance": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": {
        "not": { "enum": ["code", "script", "component", "bundle"] }
      },
      "properties": {
        "spriteId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "description": "Reference to registry asset id for sprite."
        },
        "color": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "description": "CSS color string, e.g. #ffcc00 or named color."
        }
      }
    },
    "building": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": {
        "not": { "enum": ["code", "script", "component", "bundle"] }
      },
      "required": ["id", "typeAssetId", "position"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "maxLength": 64
        },
        "typeAssetId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "description": "Reference to registry building asset id (e.g. shop_small)."
        },
        "position": { "$ref": "#/$defs/position" },
        "width": { "type": "integer", "minimum": 1, "maximum": 30 },
        "height": { "type": "integer", "minimum": 1, "maximum": 20 },
        "plot": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "maxLength": 64,
          "description": "Optional plot id — e.g. plot_1..plot_6 for town, clearing_1..clearing_4 for forest. If given, position must lie inside that plot."
        },
        "interaction": { "$ref": "#/$defs/interaction" }
      }
    },
    "scenarioObject": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": {
        "not": { "enum": ["code", "script", "component", "bundle"] }
      },
      "required": ["id", "assetId", "position"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "maxLength": 64
        },
        "assetId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "description": "Reference to registry object/prop/tile asset id."
        },
        "position": { "$ref": "#/$defs/position" },
        "plot": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "maxLength": 64,
          "description": "Optional plot/clearing id hint."
        },
        "interaction": { "$ref": "#/$defs/interaction" }
      }
    },
    "initialStats": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": {
        "not": { "enum": ["code", "script", "component", "bundle"] }
      },
      "properties": {
        "coins": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "lives": { "type": "integer", "minimum": 0, "maximum": 99 },
        "score": { "type": "integer", "minimum": 0, "maximum": 1000000 }
      },
      "description": "Optional starting stats; missing keys fallback to engine defaults (coins 40, lives 3, score 0)."
    },
    "requiredStat": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": {
        "not": { "enum": ["code", "script", "component", "bundle"] }
      },
      "required": ["stat", "operator", "target"],
      "properties": {
        "stat": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[a-z0-9_]+$",
          "description": "Stat key to evaluate (e.g. coins, score, lives)."
        },
        "operator": {
          "type": "string",
          "enum": [">=", ">", "<=", "<", "=", "==", "!="],
          "description": "Comparison operator for stat vs target."
        },
        "target": {
          "type": "number",
          "description": "Threshold value to compare against."
        }
      }
    },
    "mission": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": {
        "not": { "enum": ["code", "script", "component", "bundle"] }
      },
      "required": ["id", "title", "description"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "maxLength": 64
        },
        "title": { "type": "string", "minLength": 1, "maxLength": 100 },
        "description": { "type": "string", "minLength": 1, "maxLength": 500 },
        "trigger": { "$ref": "#/$defs/missionTrigger" },
        "checkAtEnd": { "type": "boolean" },
        "requiredStat": { "$ref": "#/$defs/requiredStat" },
        "done": { "type": "boolean" }
      }
    },
    "missionTrigger": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": {
        "not": { "enum": ["code", "script", "component", "bundle"] }
      },
      "properties": {
        "entityId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "description": "Entity id whose interaction completes the mission."
        },
        "interactionId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "auto": { "type": "boolean", "description": "If true, trigger automatically without user action." }
      }
    },
    "interaction": {
      "oneOf": [
        { "$ref": "#/$defs/interaction_dialogue" },
        { "$ref": "#/$defs/interaction_mcq" },
        { "$ref": "#/$defs/interaction_math" },
        { "$ref": "#/$defs/interaction_shop" },
        { "$ref": "#/$defs/interaction_information" }
      ]
    },
    "interaction_dialogue": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": {
        "not": { "enum": ["code", "script", "component", "bundle"] }
      },
      "required": ["type", "text"],
      "properties": {
        "type": { "const": "dialogue" },
        "text": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "speaker": { "type": "string", "minLength": 1, "maxLength": 80 },
        "cooldown": { "type": "integer", "minimum": 0, "description": "Cooldown in milliseconds before re-trigger." },
        "auto": { "type": "boolean", "description": "If true triggers on proximity without E press." },
        "onCorrect": { "$ref": "#/$defs/outcome" },
        "onWrong": { "$ref": "#/$defs/outcome" }
      }
    },
    "interaction_mcq": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": {
        "not": { "enum": ["code", "script", "component", "bundle"] }
      },
      "required": ["type", "question", "options"],
      "properties": {
        "type": { "const": "mcq" },
        "question": { "type": "string", "minLength": 1, "maxLength": 500 },
        "options": {
          "type": "array",
          "minItems": 2,
          "maxItems": 5,
          "items": { "$ref": "#/$defs/mcqOption" }
        },
        "allowRetry": { "type": "boolean" },
        "cooldown": { "type": "integer", "minimum": 0 },
        "auto": { "type": "boolean" },
        "onCorrect": { "$ref": "#/$defs/outcome" },
        "onWrong": { "$ref": "#/$defs/outcome" }
      }
    },
    "mcqOption": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": {
        "not": { "enum": ["code", "script", "component", "bundle"] }
      },
      "required": ["text", "correct"],
      "properties": {
        "text": { "type": "string", "minLength": 1, "maxLength": 200 },
        "correct": { "type": "boolean" },
        "explanation": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    },
    "interaction_math": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": {
        "not": { "enum": ["code", "script", "component", "bundle"] }
      },
      "required": ["type", "question", "answer"],
      "properties": {
        "type": { "const": "math" },
        "question": { "type": "string", "minLength": 1, "maxLength": 500 },
        "answer": {
          "anyOf": [
            { "type": "number" },
            { "type": "string", "minLength": 1, "maxLength": 100 }
          ],
          "description": "Expected answer — number for arithmetic, string for exact match."
        },
        "tolerance": { "type": "number", "minimum": 0, "description": "Numeric tolerance for floating point comparison." },
        "hint": { "type": "string", "minLength": 1, "maxLength": 300 },
        "cooldown": { "type": "integer", "minimum": 0 },
        "auto": { "type": "boolean" },
        "onCorrect": { "$ref": "#/$defs/outcome" },
        "onWrong": { "$ref": "#/$defs/outcome" }
      }
    },
    "interaction_shop": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": {
        "not": { "enum": ["code", "script", "component", "bundle"] }
      },
      "required": ["type", "items"],
      "properties": {
        "type": { "const": "shop" },
        "currency": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "default": "coins",
          "description": "Currency key, defaults to coins."
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": { "$ref": "#/$defs/shopItem" }
        },
        "cooldown": { "type": "integer", "minimum": 0 },
        "auto": { "type": "boolean" },
        "onCorrect": { "$ref": "#/$defs/outcome" },
        "onWrong": { "$ref": "#/$defs/outcome" }
      }
    },
    "shopItem": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": {
        "not": { "enum": ["code", "script", "component", "bundle"] }
      },
      "required": ["name", "price"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "maxLength": 64
        },
        "name": { "type": "string", "minLength": 1, "maxLength": 60 },
        "price": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "icon": { "type": "string", "minLength": 1, "maxLength": 10 },
        "description": { "type": "string", "minLength": 1, "maxLength": 300 }
      }
    },
    "interaction_information": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": {
        "not": { "enum": ["code", "script", "component", "bundle"] }
      },
      "required": ["type", "content"],
      "properties": {
        "type": { "const": "information" },
        "title": { "type": "string", "minLength": 1, "maxLength": 100 },
        "content": { "type": "string", "minLength": 1, "maxLength": 3000 },
        "image": { "type": "string", "minLength": 1, "maxLength": 256 },
        "cooldown": { "type": "integer", "minimum": 0 },
        "auto": { "type": "boolean" },
        "onCorrect": { "$ref": "#/$defs/outcome" },
        "onWrong": { "$ref": "#/$defs/outcome" }
      }
    }
  }
}
